# Rust build output
/target/

# Personal Claude Code settings
/.claude/settings.local.json
/.claude/**.lock

# Android SDK/NDK installed by scripts/setup-android.sh when $HOME is read-only
/.android-sdk/

# Shared app packaging and isolated vendor-test outputs (plan 0030)
/crates/qv-app/dist/
# Regenerated by tauri-build on every build, per target platform.
/crates/qv-app/gen/schemas/

# Signing keys never enter the repository (docs/RELEASE.md)
*.jks
*.keystore
*.b64
